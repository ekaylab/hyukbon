---
import { Image } from "astro:assets";
import { performance, imageFor } from "../lib/performance";

// dedupe by name, first 10 (matches previous behaviour)
const items = Array.from(
  new Map(performance.map((d) => [d.name, d])).values(),
).slice(0, 10);
---

<div class="embla cursor-pointer" data-embla>
  <ul
    class="embla__container flex touch-pan-y flex-nowrap -ml-2.5 select-none md:ml-0 xl:-ml-4"
  >
    {
      items.map((data) => (
        <li class="relative flex h-[350px] min-w-full shrink-0 overflow-hidden pl-3 md:h-[400px] md:min-w-[427px] md:justify-center xl:w-[444px] xl:pl-4">
          <div class="relative flex w-full shrink-0 flex-col justify-between overflow-hidden rounded-2xl bg-gray-100">
            <div class="flex h-full flex-col justify-between p-4 md:p-5.5 xl:px-5">
              <div class="flex items-center justify-between xl:items-start">
                <h3 class="text-18 pr-2 xl:text-21">{data.name}</h3>
                <span class="text-14 shrink-0 rounded-md bg-white px-2 py-1 font-medium text-black">
                  {data.category}
                </span>
              </div>
              <ul class="text-14 lg:text-16">
                <li class="flex items-center pt-5 md:pt-6">
                  <h4>위치</h4>
                  <p class="pl-1"> : {data.address}</p>
                </li>
                <li class="flex items-center">
                  <h4>규모</h4>
                  <p class="pl-1"> : {data.scale}</p>
                </li>
              </ul>
            </div>
            <div class="relative h-3/5 w-full shrink-0">
              {imageFor(data.image) && (
                <Image
                  src={imageFor(data.image)!}
                  alt={data.name}
                  width={888}
                  loading="eager"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  document.querySelectorAll<HTMLElement>("[data-embla]").forEach((node) => {
    EmblaCarousel(
      node,
      { dragFree: true, align: "center", loop: true, duration: 30 },
      [Autoplay({ playOnInit: true, delay: 5000 })],
    );
  });
</script>
