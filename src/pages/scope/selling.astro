---
import Layout from "../../layouts/Layout.astro";
import { performance } from "../../lib/performance";

// 페이지의 주거/비주거/호텔·관광 3분류에 실적 카테고리를 매핑 — 건수는 데이터에서 직접 센다
const GROUPS = [
  { label: "주거시설", categories: ["공동주택", "오피스텔", "타운하우스"] },
  { label: "비주거시설", categories: ["상업시설", "오피스"] },
  { label: "호텔·관광", categories: ["생활숙박시설"] },
];

const inGroup = (g: (typeof GROUPS)[number]) =>
  performance.filter((p) => g.categories.includes(p.category));

const groups = GROUPS.map((g) => {
  const items = inGroup(g);
  return {
    ...g,
    count: items.length,
    // 복합 현장은 카테고리별로 중복 등록돼 있어 이름 기준 1건만 노출
    samples: [...new Map(items.map((p) => [p.name, p])).values()].slice(0, 2),
  };
});

const total = performance.length;
const sinceYear = Math.min(
  ...performance.map((p) => Number(p.year.slice(0, 4))).filter((y) => !Number.isNaN(y)),
);
const contractors = new Set(
  performance.flatMap((p) =>
    p.contractor.split(/[,/]/).map((c) => c.trim()).filter(Boolean),
  ),
).size;
---

<Layout
  title="분양대행"
  description="시장 분석에 기반한 ㈜혁본의 분양 대행 및 마케팅 솔루션을 제안합니다."
>
  <article
    class="w-full px-4 md:px-0 pt-20 pb-40 max-w-[384px] md:w-[712px] lg:w-[948px] xl:w-[1316px] md:max-w-none mx-auto text-26 md:text-30"
  >
    <div
      class="hidden xl:fixed xl:inline-block left-10 top-40 rounded overflow-hidden"
    >
      <a href="/scope/" class="w-full flex h-full border-b border-sandline bg-white p-10 text-18 font-bold">
        사업분야
      </a>
      <ul class="pl-3 pt-1 divide-y-2 text-16">
        <li class="py-2"><a href="/scope/research/">리서치 및 시장조사</a></li>
        <li class="py-2"><a href="/scope/consulting/">마케팅 컨설팅 및 기획</a></li>
        <li class="py-2"><a href="/scope/selling/">부동산 분양대행</a></li>
        <li class="py-2"><a href="/scope/allience/">전략적 제휴</a></li>
      </ul>
    </div>
    <p class="text-14 md:text-16 font-bold tracking-[0.25em] text-main">SELLING</p>
    <h1 class="text-28 md:text-40 mt-2">부동산 분양대행</h1>
    <div class="pt-4 text-16 break-normal">
      <p>
        성공적인 분양을 위해
        <br />
        최상의 솔루션을 제안합니다.
      </p>
    </div>
    <div class="flex flex-wrap flex-row pt-20">
      <div class="w-full md:w-1/2 relative rounded-xl overflow-hidden">
        <div
          class="absolute z-10 left-5 top-4 lg:top-10 lg:left-11 text-white text-16 md:text-18"
        >
          <h3 class="text-26">SELLING BUSINESS</h3>
          <hr class="my-2" />
          <p>
            성공이라는 목표 달성을 위해
            <br />
            최선의 노력을 다할 것을 약속합니다.
          </p>
        </div>
        <img
          src="/selling.jpg"
          alt="분양대행 사업 — 주거·상업시설 분양 마케팅"
          class="w-full h-[400px] brightness-50"
          width="5863"
          height="3869"
        />
      </div>
      <ul class="w-full md:w-1/2 px-0 md:p-4">
        <li
          class="flex flex-row items-center justify-start border-t py-4 lg:px-8"
        >
          <h4 class="w-1/2">
            주거시설
            <span class="text-14 ml-2 font-medium text-main">{groups[0].count}건</span>
          </h4>
          <p class="text-16">
            아파트, 주상복합
            <br />
            타운하우스 분양대행
          </p>
        </li>
        <li
          class="flex flex-row items-center justify-start border-t py-4 lg:px-8"
        >
          <h4 class="w-1/2">
            비주거시설
            <span class="text-14 ml-2 font-medium text-main">{groups[1].count}건</span>
          </h4>
          <p class="text-16">
            상업시설, 업무시설 등<br />
            수익형 부동산 분양대행
          </p>
        </li>
        <li
          class="flex flex-row items-center justify-start border-y py-4 lg:px-8"
        >
          <h4 class="w-1/2">
            호텔/관광
            <span class="text-14 ml-2 font-medium text-main">{groups[2].count}건</span>
          </h4>
          <p class="text-16">
            생활형 숙박시설, 리조트 등<br />
            호텔 및 관광시설 분양대행
          </p>
        </li>
      </ul>
    </div>

    <!-- 실적 데이터에서 그대로 뽑는 숫자·현장 — 데이터가 늘면 같이 는다 -->
    <section class="mt-24 md:mt-32">
      <h2 class="text-22 md:text-26 font-extrabold tracking-tight">분양대행 수행 실적</h2>
      <p class="text-14 md:text-16 mt-3 font-light break-keep text-txt-03">
        {`${sinceYear}년부터 ${total}개 현장의 분양을 대행했습니다. 주거시설 ${groups[0].count}건, 비주거시설 ${groups[1].count}건, 호텔·관광 ${groups[2].count}건이며, ${contractors}개 시공사와 함께 수행했습니다.`}
      </p>

      {
        groups.map((g) => (
          <div class="mt-10">
            <h3 class="text-16 md:text-18 flex items-baseline gap-2 font-bold">
              {g.label}
              <span class="text-14 font-medium text-main">{g.count}건</span>
            </h3>
            <ul class="mt-3 divide-y divide-sandline border-t border-ink">
              {g.samples.map((p) => (
                <li class="text-14 md:text-16 flex flex-col gap-1 py-3 md:flex-row md:items-baseline md:gap-6">
                  <span class="font-bold md:w-64 md:shrink-0">{p.name}</span>
                  <span class="font-light text-txt-03">
                    {[p.contractor, p.units, p.scale, p.year].filter(Boolean).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <a
        href="/performance/"
        class="main-color-transition text-16 mt-10 inline-block border border-ink px-6 py-3 font-semibold hover:border-main hover:text-main"
      >
        전체 {total}개 현장 실적 보기
      </a>
    </section>
  </article>
</Layout>
