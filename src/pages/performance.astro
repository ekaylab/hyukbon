---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { performance, imageFor, CATEGORIES } from "../lib/performance";

const DEFAULT_CATEGORY = "공동주택";
---

<Layout
  title="업무실적"
  description="공동주택, 오피스텔, 타운하우스, 상업시설 등 ㈜혁본이 수행한 분양·개발 실적을 소개합니다."
>
  <article
    class="text-26 mx-auto w-full max-w-[384px] px-4 pb-40 pt-20 md:w-[712px] md:max-w-none md:px-0 md:text-30 lg:w-[948px] xl:w-[1316px]"
  >
    <h1 class="text-28 md:text-40">업무실적</h1>
    <div class="text-16 break-normal pt-4">
      <p>
        저희 혁본은 고객의 상품 가치 격상 및 성공적인 사업을 위해
        <br /> 투입부터 마지막까지 최선을 다하여 책임지는 기업입니다.
      </p>
    </div>

    <section class="pt-20 md:pt-32">
      <div class="mb-5">
        <ul class="flex flex-row flex-wrap justify-start gap-2" role="tablist">
          {
            CATEGORIES.map((cat) => (
              <li>
                <button
                  type="button"
                  data-tab={cat}
                  class="text-16 main-color-transition inline-flex h-10 items-center justify-center border border-sandline bg-white px-4 py-2 font-medium hover:border-main hover:text-main data-[active]:border-ink data-[active]:bg-ink data-[active]:text-ivory"
                  data-active={cat === DEFAULT_CATEGORY ? "" : null}
                >
                  {cat}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          performance.map((p) => (
            <li
              data-category={p.category}
              class:list={[
                "main-color-transition group border border-sandline bg-white hover:border-main",
                { hidden: p.category !== DEFAULT_CATEGORY },
              ]}
            >
              {imageFor(p.image) && (
                <div class="overflow-hidden border-b border-sandline">
                  <Image
                    src={imageFor(p.image)!}
                    alt={`${p.name} 조감도`}
                    width={560}
                    widths={[360, 560, 880]}
                    sizes="(min-width: 1280px) 422px, (min-width: 1024px) 300px, (min-width: 768px) 344px, calc(100vw - 32px)"
                    class="main-duration-300 h-52 w-full object-cover group-hover:scale-105"
                  />
                </div>
              )}
              <div class="p-5">
                <div class="flex items-center justify-between">
                  <span class="text-14 border border-olive/40 px-2 py-0.5 font-medium tracking-widest text-olive">
                    {p.category}
                  </span>
                  {p.year.includes("진행중") && (
                    <span class="text-14 font-bold tracking-widest text-main">진행중</span>
                  )}
                </div>
                <h3 class="text-18 lg:text-21 mt-3 font-extrabold tracking-tight">{p.name}</h3>
                <ul class="text-14 lg:text-16 mt-4 space-y-1.5 border-t border-dashed border-sandline pt-4 font-light text-ink/70">
                  <li class="flex gap-3">
                    <h4 class="text-14 w-14 shrink-0 pt-0.5 font-bold tracking-widest text-olive">위치</h4>
                    <p>{p.address}</p>
                  </li>
                  <li class="flex gap-3">
                    <h4 class="text-14 w-14 shrink-0 pt-0.5 font-bold tracking-widest text-olive">규모</h4>
                    <p>{p.scale}</p>
                  </li>
                  {p.units && (
                    <li class="flex gap-3">
                      <h4 class="text-14 w-14 shrink-0 pt-0.5 font-bold tracking-widest text-olive">세대수</h4>
                      <p>{p.units}</p>
                    </li>
                  )}
                  <li class="flex gap-3">
                    <h4 class="text-14 w-14 shrink-0 pt-0.5 font-bold tracking-widest text-olive">건설사</h4>
                    <p>{p.contractor}</p>
                  </li>
                  <li class="flex gap-3">
                    <h4 class="text-14 w-14 shrink-0 pt-0.5 font-bold tracking-widest text-olive">일시</h4>
                    <p>{p.year}</p>
                  </li>
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const cat = tab.dataset.tab;
      tabs.forEach((t) =>
        t === tab
          ? t.setAttribute("data-active", "")
          : t.removeAttribute("data-active"),
      );
      cards.forEach((card) =>
        card.classList.toggle("hidden", card.dataset.category !== cat),
      );
    });
  });
</script>
