---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ArrowCircleRight from "../components/ArrowCircleRight.astro";
import { performance, imageFor } from "../lib/performance";

// 실적 데이터에서 그대로 뽑는 숫자 — 데이터가 늘면 같이 는다
const total = performance.length;
const ongoing = performance.filter((p) => p.year.includes("진행중")).length;
const contractors = new Set(
  performance.flatMap((p) =>
    p.contractor.split(/[,/]/).map((c) => c.trim()).filter(Boolean),
  ),
).size;
const sinceYear = Math.min(
  ...performance
    .map((p) => Number(p.year.slice(0, 4)))
    .filter((y) => !Number.isNaN(y)),
);

const hero = performance[0];
const highlights = performance.slice(0, 6);

const stats = [
  { value: String(total), suffix: "곳", label: "누적 수행 현장" },
  { value: String(contractors), suffix: "사", label: "협력 시공사" },
  { value: String(new Date().getFullYear() - sinceYear), suffix: "년", label: `${sinceYear}년부터` },
  { value: String(ongoing), suffix: "곳", label: "진행중 현장" },
];

const scopes = [
  { href: "/scope/research", en: "RESEARCH", ko: "리서치 및 시장조사" },
  { href: "/scope/consulting", en: "CONSULTING", ko: "마케팅 컨설팅 및 기획" },
  { href: "/scope/selling", en: "SELLING", ko: "부동산 분양대행" },
  { href: "/scope/allience", en: "ALLIENCE", ko: "전략적 제휴" },
];

const values = [
  {
    name: "최대 이익 창출",
    desc: "축적된 노하우와 데이터베이스를 통해 최소의 비용으로 최대의 고객이익 창출",
  },
  {
    name: "가치의 극대화",
    desc: "경험이 풍부한 임직원, 부동산 관련업계를 통한 상호 소통 중점의 유기적 업무 플로우 구축",
  },
  {
    name: "신의 성실 윤리",
    desc: "철저한 윤리규정 준수를 통한 투명한 업무 수행, 고객의 이익을 우선시하는 운영 방안 기획",
  },
  {
    name: "고객의 만족도",
    desc: "안정성을 기반으로 높은 품질의 서비스, 수행과정 및 결과에 대한 상세한 피드백 제공",
  },
];
---

<Layout>
  <article class="overflow-x-hidden">
    <h1 class="sr-only">혁본 — 분양대행·부동산개발 전문기업</h1>

    <!-- 히어로 — 실제 수행 현장 -->
    <section class="facade border-b border-sandline">
      <div
        class="mx-auto grid w-full max-w-[384px] items-center gap-10 px-4 py-16 md:w-[712px] md:max-w-none md:px-0 md:py-24 lg:w-[948px] lg:grid-cols-[1fr_1fr] xl:w-[1316px] xl:grid-cols-[10fr_11fr]"
      >
        <div>
          <p class="text-14 flex items-center gap-3 font-bold tracking-[0.25em] text-main">
            <span class="inline-block h-px w-8 bg-main"></span>
            부동산 분양대행 · 분양기획 · 마케팅
          </p>
          <h2
            class="text-38 mt-5 max-w-3xl font-extrabold tracking-tight md:text-50 md:leading-[1.15]"
          >
            {sinceYear}년부터 {total}개 현장,<br />숫자로 증명합니다
          </h2>
          <p class="text-16 md:text-18 mt-6 max-w-2xl font-light break-keep text-ink/70">
            혁본은 분양기획부터 조직 세팅, 완판까지 현장 전 과정을 책임지는 부동산
            마케팅 전문기업입니다. 고객의 가치 실현을 최우선으로 빛나는 성과를
            만듭니다.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/performance"
              class="main-color-transition text-16 bg-ink px-6 py-3.5 font-bold text-ivory hover:bg-main"
            >
              수행실적 보기
            </a>
            <a
              href="/(주)혁본 지명원.pdf"
              class="main-color-transition text-16 flex items-center gap-2 border border-ink px-6 py-3.5 font-semibold hover:border-main hover:text-main"
            >
              회사 지명원 다운로드 <ArrowCircleRight />
            </a>
          </div>
        </div>
        {
          hero && imageFor(hero.image) && (
            <figure class="relative hidden lg:block">
              <Image
                src={imageFor(hero.image)!}
                alt={`${hero.name} 조감도`}
                width={1400}
                class="w-full border border-sandline bg-white p-1.5"
                loading="eager"
              />
              <figcaption class="text-14 mt-2 flex items-center justify-between font-medium tracking-widest text-olive">
                <span>{hero.name}</span>
                <span class="text-main">{hero.year.includes("진행중") ? "진행중" : "수행완료"}</span>
              </figcaption>
            </figure>
          )
        }
      </div>
    </section>

    <!-- 숫자 밴드 -->
    <section class="facade-dark border-b border-sandline bg-ink text-ivory">
      <div
        class="mx-auto grid w-full max-w-[384px] grid-cols-2 md:w-[712px] md:max-w-none md:grid-cols-4 md:divide-x md:divide-ivory/10 lg:w-[948px] xl:w-[1316px]"
      >
        {
          stats.map((s) => (
            <div class="px-4 py-8 md:px-6 md:py-10">
              <p class="text-30 md:text-40 font-extrabold tracking-tight">
                {s.value}<span class="text-ivory/50">{s.suffix}</span>
              </p>
              <p class="text-14 mt-1 text-ivory/55">{s.label}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 사업분야 -->
    <section class="border-b border-sandline">
      <div
        class="mx-auto w-full max-w-[384px] px-4 py-16 md:w-[712px] md:max-w-none md:px-0 md:py-24 lg:w-[948px] xl:w-[1316px]"
      >
        <h2 class="text-14 font-bold tracking-[0.25em] text-main">BUSINESS</h2>
        <p class="text-26 md:text-36 mt-3 font-extrabold tracking-tight">사업분야</p>
        <ul class="mt-10 grid gap-px border border-sandline bg-sandline md:grid-cols-4">
          {
            scopes.map((s, i) => (
              <li class="bg-ivory">
                <a
                  href={s.href}
                  class="main-color-transition group block h-full p-6 hover:bg-white"
                >
                  <p class="text-14 font-bold text-main">{String(i + 1).padStart(2, "0")}</p>
                  <h3 class="text-21 main-color-transition mt-3 font-extrabold tracking-tight group-hover:text-main">
                    {s.en}
                  </h3>
                  <p class="text-14 mt-1 font-light text-ink/70">{s.ko}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 수행실적 하이라이트 — 실제 현장 -->
    <section class="border-b border-sandline bg-white/50">
      <div
        class="mx-auto w-full max-w-[384px] px-4 py-16 md:w-[712px] md:max-w-none md:px-0 md:py-24 lg:w-[948px] xl:w-[1316px]"
      >
        <div class="flex items-end justify-between">
          <div>
            <h2 class="text-14 font-bold tracking-[0.25em] text-main">PORTFOLIO</h2>
            <p class="text-26 md:text-36 mt-3 font-extrabold tracking-tight">함께한 현장들</p>
          </div>
          <a
            href="/performance"
            class="main-color-transition text-14 md:text-16 flex items-center gap-1.5 font-semibold hover:text-main"
          >
            전체 {total}개 현장 <ArrowCircleRight />
          </a>
        </div>
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            highlights.map((p) => (
              <li class="main-color-transition group border border-sandline bg-ivory hover:border-main">
                {imageFor(p.image) && (
                  <div class="overflow-hidden border-b border-sandline">
                    <Image
                      src={imageFor(p.image)!}
                      alt={`${p.name} 조감도`}
                      width={820}
                      class="main-duration-300 h-44 w-full object-cover group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-5">
                  <div class="flex items-center justify-between">
                    <span class="text-14 border border-olive/40 px-2 py-0.5 font-medium tracking-widest text-olive">
                      {p.category}
                    </span>
                    {p.year.includes("진행중") && (
                      <span class="text-14 font-bold tracking-widest text-main">진행중</span>
                    )}
                  </div>
                  <h3 class="text-18 main-color-transition mt-3 font-extrabold tracking-tight group-hover:text-main">
                    {p.name}
                  </h3>
                  <p class="text-14 mt-1.5 font-light text-ink/60">
                    {p.address.split(" ").slice(0, 2).join(" ")} · {p.scale}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 핵심가치 -->
    <section class="border-b border-sandline">
      <div
        class="mx-auto w-full max-w-[384px] px-4 py-16 md:w-[712px] md:max-w-none md:px-0 md:py-24 lg:w-[948px] xl:w-[1316px]"
      >
        <h2 class="text-14 font-bold tracking-[0.25em] text-main">VALUE</h2>
        <p class="text-26 md:text-36 mt-3 font-extrabold tracking-tight">
          고객이 있기에 저희가 있습니다
        </p>
        <ul class="mt-10 grid gap-x-8 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
          {
            values.map((v) => (
              <li class="border-t-2 border-ink pt-4">
                <h3 class="text-16 md:text-18 font-bold">{v.name}</h3>
                <p class="text-14 mt-2 font-light break-keep text-ink/70">{v.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 문의 -->
    <section class="facade-dark bg-ink text-ivory">
      <div
        class="mx-auto w-full max-w-[384px] px-4 py-16 md:w-[712px] md:max-w-none md:px-0 md:py-24 lg:w-[948px] xl:w-[1316px]"
      >
        <h2 class="text-14 font-bold tracking-[0.25em] text-main">CONTACT</h2>
        <p class="text-26 md:text-36 mt-3 font-extrabold tracking-tight">
          현장 조건부터 들려주십시오
        </p>
        <div class="mt-10 grid gap-10 md:grid-cols-2">
          <div class="space-y-5">
            <a
              href="tel:1522-9432"
              class="main-color-transition text-38 md:text-50 block font-extrabold tracking-tight hover:text-main"
            >
              1522-9432
            </a>
            <dl class="text-14 space-y-2 text-ivory/70">
              <div class="flex gap-4">
                <dt class="text-12 w-12 shrink-0 font-bold tracking-widest text-ivory/40">FAX</dt>
                <dd>050-4132-9432</dd>
              </div>
              <div class="flex gap-4">
                <dt class="text-12 w-12 shrink-0 font-bold tracking-widest text-ivory/40">ADDR</dt>
                <dd>경기도 화성시 동탄기흥로 614, 더퍼스트타워2차 301호</dd>
              </div>
            </dl>
          </div>
          <div class="flex items-start justify-start md:justify-end">
            <a
              href="/(주)혁본 지명원.pdf"
              class="main-color-transition text-18 bg-main px-8 py-4 font-bold text-white hover:bg-ivory hover:text-ink"
            >
              회사 지명원 받기
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>
